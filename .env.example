# RoboPulse Environment Variables
# Copy this file to .env and fill in your values

# WordPress REST API root URL
VITE_WP_API_URL=https://your-wordpress-domain.com/wp-json

# Keep true when you want React to load WordPress content.
# Set false to force local fallback content only.
VITE_ENABLE_WORDPRESS=true

# Set true only when you want to ignore WordPress and use existing local content.
VITE_USE_MOCK=false

# Optional: Analytics
VITE_GA_ID=G-XXXXXXXXXX
